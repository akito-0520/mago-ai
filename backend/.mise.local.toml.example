# backend/.mise.local.toml.example
# このファイルを .mise.local.toml にコピーして値を埋める（.mise.local.toml は gitignore）

[env]
# --- Server ---
PORT = "8080"

# --- Supabase（ローカル CLI の起動時に出力される値を貼る） ---
DATABASE_URL               = "postgres://postgres:postgres@127.0.0.1:54322/postgres"
SUPABASE_URL               = "http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY  = ""

# --- Anthropic Claude ---
ANTHROPIC_API_KEY = ""
CLAUDE_MODEL      = "claude-sonnet-4-6"

# --- Conversation ---
# 会話履歴の自動リセットまでの時間（時間単位の整数）
CONVERSATION_WINDOW_HOURS = "24"

# --- LINE Messaging API（おばあちゃん用 dev チャネル） ---
LINE_CHANNEL_SECRET        = ""
LINE_CHANNEL_ACCESS_TOKEN  = ""

# --- LINE Messaging API（孫への通知用 dev チャネル） ---
# おばあちゃんからの「解決しなかった」フィードバックを孫に Push する用の別チャネル
LINE_NOTIFY_CHANNEL_SECRET        = ""
LINE_NOTIFY_CHANNEL_ACCESS_TOKEN  = ""

# --- Google OAuth（ローカル Supabase 用） ---
# Google Cloud Console → Credentials → OAuth 2.0 Client IDs で作成した値
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID  = ""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET     = ""